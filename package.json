{
  "name": "club-hunt",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "bun --cwd apps/web run dev",
    "dev:api": "bun --cwd apps/api run dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "bun --cwd packages/db run migrate",
    "db:generate": "bun --cwd packages/db run generate",
    "db:seed": "bun --cwd packages/db run seed",
    "db:studio": "bun --cwd packages/db run studio",
    "test": "bun --cwd apps/api test",
    "typecheck": "bun --cwd apps/api run typecheck && bun --cwd apps/web run typecheck"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
